# Public values and local file paths only. Never commit real private keys or passwords.
DYSTOPAI_WINDOWS_INSTALLER=release/DystopAI-Setup-0.0.6-x64.exe
DYSTOPAI_UPDATE_URL=https://github.com/OWNER/REPOSITORY/releases/download/v0.0.6/DystopAI-Setup-0.0.6-x64.exe
DYSTOPAI_UPDATE_CHANNEL=stable
DYSTOPAI_UPDATE_SIGNING_PRIVATE_KEY_FILE=C:/secure/dystopai-update-ed25519.pem
DYSTOPAI_UPDATE_SIGNING_KEY_ID=dystopai-update-key-1
DYSTOPAI_UPDATE_REQUIRE_SIGNING=1
DYSTOPAI_RELEASE_SIGNING_PRIVATE_KEY_FILE=C:/secure/dystopai-release-ed25519.pem
DYSTOPAI_RELEASE_SIGNING_KEY_ID=dystopai-release-key-1
DYSTOPAI_RELEASE_REQUIRE_SIGNING=1
# electron-builder platform signing uses CSC_LINK/CSC_KEY_PASSWORD on Windows
# and CSC_LINK/CSC_KEY_PASSWORD + APPLE_ID/APPLE_APP_SPECIFIC_PASSWORD/APPLE_TEAM_ID on macOS.

# Optional development/emergency overrides. Production releases use
# https://api.automnia.ai for both routes when these are unset.
AUTOMNIA_LICENSE_API_URL=https://staging.automnia.ai
AUTOMNIA_CLOUD_RELAY_URL=https://staging.automnia.ai
