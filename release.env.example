# Public values and local file paths only. Never commit real private keys or passwords.
AUTOMNIA_WINDOWS_INSTALLER=release/Automnia-Setup-0.0.6-x64.exe
AUTOMNIA_UPDATE_URL=https://github.com/OWNER/REPOSITORY/releases/download/v0.0.6/Automnia-Setup-0.0.6-x64.exe
AUTOMNIA_UPDATE_CHANNEL=stable
AUTOMNIA_UPDATE_SIGNING_PRIVATE_KEY_FILE=C:/secure/automnia-update-ed25519.pem
AUTOMNIA_UPDATE_SIGNING_KEY_ID=automnia-update-key-1
AUTOMNIA_UPDATE_REQUIRE_SIGNING=1
AUTOMNIA_RELEASE_SIGNING_PRIVATE_KEY_FILE=C:/secure/automnia-release-ed25519.pem
AUTOMNIA_RELEASE_SIGNING_KEY_ID=automnia-release-key-1
AUTOMNIA_RELEASE_REQUIRE_SIGNING=1
# electron-builder platform signing uses CSC_LINK/CSC_KEY_PASSWORD on Windows
# and CSC_LINK/CSC_KEY_PASSWORD + APPLE_ID/APPLE_APP_SPECIFIC_PASSWORD/APPLE_TEAM_ID on macOS.

# Optional development/emergency overrides. Production releases use
# the temporary Cloud Run origin for both routes when these are unset.
AUTOMNIA_LICENSE_API_URL=https://automnia-shopify-provisioner-idkndr7vfq-ue.a.run.app
AUTOMNIA_CLOUD_RELAY_URL=https://automnia-shopify-provisioner-idkndr7vfq-ue.a.run.app
