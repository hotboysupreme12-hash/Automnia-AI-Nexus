{
  "name": "openclaw-control-center",
  "private": true,
  "version": "0.0.6",
  "description": "Standalone DystopAI OpenClaw control center desktop app.",
  "author": {
    "name": "DystopAI"
  },
  "homepage": "https://github.com/hotboysupreme12-hash/DystopAI-Core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotboysupreme12-hash/DystopAI-Core.git"
  },
  "bugs": {
    "url": "https://github.com/hotboysupreme12-hash/DystopAI-Core/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "npm run prepare:openclaw-vendor && tsx watch server/index.ts",
    "dev:desktop": "npm run build:client && npm run build:server && npm run prepare:openclaw-vendor && electron .",
    "build": "npm run build:client",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --define:import.meta.url=__filename",
    "build:standalone": "npm run build:client && npm run build:server",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "smoke:openclaw": "node scripts/smoke-openclaw-contracts.mjs && tsx scripts/smoke-diagnostic-redaction.ts && tsx scripts/smoke-sse-parser.ts && tsx scripts/smoke-agent-turn-stream.ts",
    "smoke:ledger": "tsx scripts/smoke-runtime-ledger-jsonl-tail.ts",
    "smoke:control-center-state": "tsx scripts/smoke-control-center-sqlite-state.ts",
    "smoke:config-save": "tsx scripts/smoke-config-save-lifecycle.ts",
    "smoke:auth": "tsx scripts/smoke-auth-control-plane.ts",
    "smoke:auth-provider-model": "tsx scripts/smoke-auth-provider-model-control-plane.ts",
    "smoke:model-catalog-service": "tsx scripts/smoke-model-catalog-service.ts",
    "smoke:provider-auth-service": "tsx scripts/smoke-provider-auth-service.ts",
    "smoke:oauth-callback-service": "tsx scripts/smoke-oauth-callback-service.ts",
    "smoke:provider-setup-service": "tsx scripts/smoke-provider-setup-service.ts",
    "smoke:provider-auth-beta": "tsx scripts/smoke-provider-auth-beta-coverage.ts",
    "smoke:security": "tsx scripts/smoke-security-hardening.ts",
    "smoke:runtime-recovery-soak": "tsx scripts/smoke-runtime-recovery-soak.ts",
    "smoke:runtime-reproducibility": "tsx scripts/smoke-runtime-reproducibility.ts",
    "smoke:release-evidence": "tsx scripts/smoke-release-evidence.ts",
    "smoke:release-signing": "tsx scripts/smoke-release-signing.ts",
    "smoke:release-lifecycle": "tsx scripts/smoke-release-lifecycle.ts",
    "smoke:release-validation": "tsx scripts/smoke-release-validation.ts",
    "smoke:electron-e2e": "tsx scripts/smoke-electron-e2e.ts",
    "smoke:packaged-electron-launch": "tsx scripts/smoke-packaged-electron-launch.ts",
    "smoke:ci-workflow": "tsx scripts/smoke-ci-workflow.ts",
    "smoke:server-architecture": "tsx scripts/smoke-server-entrypoint-boundary.ts",
    "smoke:route-inventory": "tsx scripts/smoke-route-inventory.ts",
    "smoke:shell-production-ui": "tsx scripts/smoke-shell-production-ui.ts",
    "smoke:interactive-controls": "tsx scripts/smoke-interactive-controls.ts",
    "smoke:ui-contrast": "tsx scripts/smoke-ui-contrast-tokens.ts",
    "smoke:ui-font-sizes": "tsx scripts/smoke-ui-font-sizes.ts",
    "smoke:ui-primitives": "tsx scripts/smoke-ui-primitives.ts",
    "smoke:session-tokens": "tsx scripts/smoke-session-token-store.ts",
    "smoke:gateway-auth-hardening": "tsx scripts/smoke-gateway-auth-hardening.ts",
    "smoke:gateway-lifecycle": "tsx scripts/smoke-gateway-lifecycle-service.ts",
    "smoke:gateway-diagnostics": "tsx scripts/smoke-gateway-diagnostics-service.ts",
    "smoke:gateway-logs": "tsx scripts/smoke-gateway-log-service.ts",
    "smoke:gateway-chat": "tsx scripts/smoke-gateway-chat-service.ts",
    "secret:scan": "node scripts/secret-scan.cjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "smoke:mission-verification": "tsx scripts/smoke-mission-verification.ts",
    "smoke:mission-report": "tsx scripts/smoke-mission-report-truth.ts",
    "smoke:mission-report-service": "tsx scripts/smoke-mission-report-service.ts",
    "smoke:mission-recovery": "tsx scripts/smoke-mission-recovery-service.ts",
    "smoke:mission-restart-recovery": "tsx scripts/smoke-mission-restart-recovery.ts",
    "smoke:mission-team-sync": "tsx scripts/smoke-mission-team-sync-service.ts",
    "smoke:mission-durable-state": "tsx scripts/smoke-mission-durable-state.ts",
    "smoke:mission-idempotency": "tsx scripts/smoke-mission-idempotency.ts",
    "smoke:mission-cron-reconciliation": "tsx scripts/smoke-mission-cron-reconciliation.ts",
    "smoke:mission-scheduler": "tsx scripts/smoke-mission-scheduler-service.ts",
    "smoke:mission-cancellation": "tsx scripts/smoke-mission-cancellation.ts",
    "smoke:mission-runtime-references": "tsx scripts/smoke-mission-runtime-references.ts",
    "smoke:mission-gateway-reconciliation": "tsx scripts/smoke-mission-gateway-reconciliation.ts",
    "smoke:mission-lifecycle-projection": "tsx scripts/smoke-mission-lifecycle-projection.ts",
    "smoke:mission-backend-owned": "tsx scripts/smoke-mission-backend-owned.ts",
    "smoke:api-envelope": "tsx scripts/smoke-api-envelope.ts",
    "smoke:api-error-redaction": "tsx scripts/smoke-api-error-redaction.ts",
    "smoke:control-plane-errors": "tsx scripts/smoke-control-plane-error-handler.ts",
    "smoke:api-integration": "tsx scripts/smoke-api-integration.ts",
    "smoke:error-boundary": "tsx scripts/smoke-error-boundary.ts",
    "smoke:skills-control-plane": "tsx scripts/smoke-skills-control-plane.ts",
    "smoke:plugins-control-plane": "tsx scripts/smoke-plugins-control-plane.ts",
    "smoke:plugin-inventory-service": "tsx scripts/smoke-plugin-inventory-service.ts",
    "smoke:plugin-install-service": "tsx scripts/smoke-plugin-install-service.ts",
    "smoke:plugin-diagnostics-service": "tsx scripts/smoke-plugin-diagnostics-service.ts",
    "smoke:plugin-runtime-service": "tsx scripts/smoke-plugin-runtime-service.ts",
    "smoke:openclaw-command-control-plane": "tsx scripts/smoke-openclaw-command-control-plane.ts",
    "smoke:party-coordination-control-plane": "tsx scripts/smoke-party-coordination-control-plane.ts",
    "smoke:team-sync-control-plane": "tsx scripts/smoke-team-sync-control-plane.ts",
    "smoke:agent-turn-control-plane": "tsx scripts/smoke-agent-turn-control-plane.ts",
    "smoke:runtime-status-control-plane": "tsx scripts/smoke-runtime-status-control-plane.ts",
    "smoke:runtime-actions-control-plane": "tsx scripts/smoke-runtime-actions-control-plane.ts",
    "smoke:shifts-control-plane": "tsx scripts/smoke-shifts-control-plane.ts",
    "smoke:filesystem-control-plane": "tsx scripts/smoke-filesystem-control-plane.ts",
    "smoke:command-console-files": "tsx scripts/smoke-command-console-files-control-plane.ts",
    "smoke:renderer-store-boundary": "tsx scripts/smoke-renderer-store-boundary.ts",
    "smoke:nexus-control-plane": "tsx scripts/smoke-nexus-control-plane.ts",
    "smoke:misc-control-plane": "tsx scripts/smoke-misc-control-plane.ts",
    "smoke:ui": "node scripts/smoke-ui-render.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:unit:coverage": "node scripts/run-unit-tests.mjs --coverage",
    "test": "npm run test:ci",
    "test:ci": "npm run lint && npm run typecheck && npm run test:unit && npm run notices:check && npm run smoke:server-architecture && npm run smoke:route-inventory && npm run smoke:shell-production-ui && npm run smoke:interactive-controls && npm run smoke:ledger && npm run smoke:control-center-state && npm run smoke:mission-verification && npm run smoke:mission-report && npm run smoke:mission-report-service && npm run smoke:mission-recovery && npm run smoke:mission-restart-recovery && npm run smoke:mission-team-sync && npm run smoke:mission-durable-state && npm run smoke:mission-idempotency && npm run smoke:mission-cron-reconciliation && npm run smoke:mission-scheduler && npm run smoke:mission-cancellation && npm run smoke:mission-runtime-references && npm run smoke:mission-gateway-reconciliation && npm run smoke:mission-lifecycle-projection && npm run smoke:mission-backend-owned && npm run smoke:api-envelope && npm run smoke:api-error-redaction && npm run smoke:control-plane-errors && npm run smoke:api-integration && npm run smoke:runtime-recovery-soak && npm run smoke:error-boundary && npm run smoke:skills-control-plane && npm run smoke:plugins-control-plane && npm run smoke:plugin-inventory-service && npm run smoke:plugin-install-service && npm run smoke:plugin-diagnostics-service && npm run smoke:plugin-runtime-service && npm run smoke:openclaw-command-control-plane && npm run smoke:openclaw && npm run smoke:party-coordination-control-plane && npm run smoke:team-sync-control-plane && npm run smoke:agent-turn-control-plane && npm run smoke:runtime-status-control-plane && npm run smoke:runtime-actions-control-plane && npm run smoke:shifts-control-plane && npm run smoke:filesystem-control-plane && npm run smoke:command-console-files && npm run smoke:renderer-store-boundary && npm run smoke:nexus-control-plane && npm run smoke:misc-control-plane && npm run smoke:config-save && npm run smoke:auth && npm run smoke:auth-provider-model && npm run smoke:model-catalog-service && npm run smoke:provider-auth-service && npm run smoke:oauth-callback-service && npm run smoke:provider-setup-service && npm run smoke:provider-auth-beta && npm run smoke:security && npm run smoke:production-security-delta && npm run smoke:session-tokens && npm run smoke:gateway-auth-hardening && npm run smoke:gateway-lifecycle && npm run smoke:gateway-diagnostics && npm run smoke:gateway-logs && npm run smoke:gateway-chat && npm run secret:scan && npm run smoke:runtime-reproducibility && npm run smoke:release-evidence && npm run smoke:release-signing && npm run smoke:release-validation && npm run smoke:release-lifecycle && npm run smoke:ci-workflow",
    "desktop": "npm run build:standalone && npm run prepare:openclaw-vendor && electron .",
    "prepare:runtime-bundles": "node scripts/prepare-runtime-bundles.cjs",
    "prepare:openclaw-vendor": "node scripts/prepare-openclaw-vendor.cjs",
    "release:update-manifest": "node scripts/generate-update-manifest.cjs",
    "release:update-verify": "node scripts/verify-update-manifest.cjs",
    "release:lifecycle:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-release-lifecycle.ps1",
    "release:evidence": "node scripts/generate-release-evidence.cjs",
    "release:sign": "node scripts/sign-release-evidence.cjs",
    "release:validate": "node scripts/validate-release-artifacts.cjs",
    "package:desktop": "npm run build:standalone && npm run prepare:runtime-bundles && npm run prepare:openclaw-vendor && node scripts/package-desktop.cjs --dir",
    "dist:desktop": "npm run package:desktop",
    "dist:win": "npm run build:standalone && npm run prepare:runtime-bundles && npm run prepare:openclaw-vendor && node scripts/package-desktop.cjs --win --x64",
    "dist:win:dir": "npm run build:standalone && npm run prepare:runtime-bundles && npm run prepare:openclaw-vendor && node scripts/package-desktop.cjs --dir --win --x64",
    "state:backup": "node scripts/runtime-state-backup.cjs backup",
    "state:verify": "node scripts/runtime-state-backup.cjs verify",
    "state:restore": "node scripts/runtime-state-backup.cjs restore",
    "verify:release-candidate": "npm test && npm run test:unit:coverage && npm run smoke:api-soak && npm run build:standalone && npm run check:bundle-budgets && npm run smoke:electron-e2e",
    "dist:mac": "npm run build:standalone && npm run prepare:runtime-bundles && npm run prepare:openclaw-vendor && node scripts/package-desktop.cjs --mac",
    "dist:linux": "npm run build:standalone && npm run prepare:runtime-bundles && npm run prepare:openclaw-vendor && node scripts/package-desktop.cjs --linux --x64",
    "docs:openclaw:sync": "node scripts/sync-openclaw-docs.mjs",
    "setup:gateway-auth": "node scripts/setup-openclaw-gateway-auth.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.electron.json --noEmit",
    "typecheck:electron": "node ./node_modules/typescript/bin/tsc -p tsconfig.electron.json --noEmit",
    "typecheck:server": "node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server scripts tests",
    "preview": "vite preview",
    "start": "npm run prepare:openclaw-vendor && tsx server/index.ts",
    "smoke:api-soak": "tsx scripts/smoke-api-soak.ts",
    "smoke:production-security-delta": "tsx scripts/smoke-production-security-delta.ts",
    "notices:generate": "node scripts/generate-third-party-notices.cjs",
    "notices:check": "node scripts/generate-third-party-notices.cjs --check"
  },
  "build": {
    "appId": "ai.dystopai.controlcenter",
    "productName": "DystopAI",
    "icon": "build/icon-graphite.png",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist-server",
        "to": "dist-server"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build/icon-graphite.png",
        "to": "icon.png"
      },
      {
        "from": "vendor/openclaw",
        "to": "openclaw"
      },
      {
        "from": ".openclaw/agents",
        "to": "openclaw/agents"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "legal/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "DATA_HANDLING.md",
        "to": "legal/DATA_HANDLING.md"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "DystopAI",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.34.2",
    "node-pty": "^1.2.0-beta.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-spawn": "^7.0.6",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "wait-on": "^9.0.10"
  }
}
